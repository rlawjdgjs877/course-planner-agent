# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요.
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다.
OPENAI_API_KEY=
# 사용할 모델 이름. https://platform.openai.com/docs/models 에서 고릅니다.
OPENAI_MODEL=

# 경북대 이수 과목 불러오기 (실험 기능). 기본은 꺼져 있다.
# 켜면 서버가 띄운 브라우저가 학생의 학교 로그인과 세션을 거치게 된다. README 의 주의 사항을 먼저 읽을 것.
# KNU_IMPORT_ENABLED=1
# KNU_IMPORT_ALLOW_REMOTE=1   # 이 컴퓨터 밖의 사용자에게도 열기 (보안 검토 전에는 켜지 말 것)
